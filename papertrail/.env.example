APP_NAME=PaperTrail
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://papertrail-to.online
APP_CONFIG_CACHE=true

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=papertrail
DB_USERNAME=papertrail
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_ROOT

BROADCAST_DRIVER=null
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_DOMAIN=.papertrail-to.online
SESSION_SECURE_COOKIE=true

TRUSTED_HOSTS=^papertrail-to\.online$,^www\.papertrail-to\.online$
CORS_ALLOWED_ORIGINS=https://papertrail-to.online,https://www.papertrail-to.online
CORS_SUPPORTS_CREDENTIALS=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@papertrail-to.online
MAIL_FROM_NAME="PaperTrail - LGU Tomas Oppus"
PAPERTRAIL_EMAIL_NOTIFICATIONS=true
PAPERTRAIL_ATTACHMENT_MAX_SIZE_KB=10240

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT=30
PAPERTRAIL_AI_SUMMARY_CACHE_SECONDS=300

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
